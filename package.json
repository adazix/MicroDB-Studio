{
  "name": "microdb-studio",
  "version": "1.1.0",
  "type": "module",
  "description": "MicroDB Studio - Software de escritorio y visor/gestor visual de bases de datos para tarjetas SD con MicroDB y compatibilidad con DBeaver",
  "author": "Jairo Antonio Rohatan Zapata & Adazix Systems S.A.S",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "pnpm build:client && pnpm build:server",
    "start": "tsx server/index.ts",
    "desktop:dev": "concurrently \"pnpm dev:server\" \"wait-on http://localhost:3001 && electron electron/main.cjs\"",
    "desktop:start": "pnpm build && electron electron/main.cjs",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:portable": "pnpm build && electron-builder --win portable"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "dependencies": {
    "@types/sql.js": "^1.4.11",
    "alasql": "^4.4.0",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.adazix.microdbstudio",
    "productName": "MicroDB Studio",
    "copyright": "Copyright © 2026 Adazix Systems S.A.S & Jairo Antonio Rohatan Zapata",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MicroDB Studio"
    }
  }
}
